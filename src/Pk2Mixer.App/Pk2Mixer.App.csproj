<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Pk2Mixer.App</RootNamespace>
    <AssemblyName>Pk2Mixer</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\assets\pk2-mixer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- window / taskbar icon (also reused by the Linux desktop entry) -->
    <AvaloniaResource Include="..\..\assets\pk2-mixer.png" Link="Assets\pk2-mixer.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pk2Mixer.Core\Pk2Mixer.Core.csproj" />
  </ItemGroup>

</Project>
