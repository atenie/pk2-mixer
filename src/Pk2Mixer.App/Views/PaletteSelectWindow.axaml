<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pk2Mixer.App.Views.PaletteSelectWindow"
        Title="Select palette"
        Width="860" Height="580"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="search" VerticalAlignment="Center" />
      <TextBox Width="240" Text="{Binding Search, Mode=TwoWay}" Watermark="PALT, FLATC, defaul…" />
      <TextBlock Text="{Binding CountLabel}" Opacity="0.6" VerticalAlignment="Center" />
      <Button Content="Browse…" Click="Browse_Click" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button Content="Use palette" Click="Ok_Click" IsDefault="True"
              IsEnabled="{Binding HasSelection}" />
    </StackPanel>

    <Grid ColumnDefinitions="*,8,320">
      <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" FontSize="12" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#333333" />

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Details}" TextWrapping="Wrap"
                   FontSize="11" Opacity="0.75" Margin="0,8,0,0" />
        <Border Background="#191919" CornerRadius="3">
          <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="4" />
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
